# Frontend environment variables (Vite exposes only VITE_-prefixed vars).
# Copy to .env.local for local dev, or set them in the Vercel dashboard.

# Where the API lives. Leave EMPTY (recommended): the site calls /api on its
# own origin — Vite proxies it to http://127.0.0.1:8010 in dev and vercel.json
# rewrites it to Render in production, so login cookies stay first-party.
VITE_API_BASE=

# Seconds without a new reading before a part shows as "Stale".
VITE_STALE_SECONDS=60

# Preview builds only: run the whole site against an in-browser mock API.
# VITE_MOCK_API=1
