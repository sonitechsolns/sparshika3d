# Frontend environment variables (Vite exposes only VITE_-prefixed vars).
# Copy to .env.local for local dev, or set these in the Vercel dashboard.

# Base URL of the Sparshika cloud API (no trailing slash).
# Dev default when unset: http://localhost:8010
VITE_API_BASE=https://sparshika-api.onrender.com

# Site whose WorldStateSnapshot the twin polls.
VITE_SITE_ID=dc-west-1
